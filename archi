#!/usr/bin/env python3
"""archi: the agent's own command line (stdlib only, works without the venv).

Operations
  archi status                       services, provider, model, pairing, running turns (no secrets)
  archi restart [--when-idle] [--delay N] [--max-wait S]
                                     restart the door(s); from inside a turn it is always deferred
  archi logs [-n N] [--door D]       recent service log lines (journalctl; never follows)
  archi validate                     syntax, imports, dry start, config sanity; non-zero on failure
  archi update [--no-restart]        pull upstream, keep local changes, validate, restart when idle
  archi identity set-name "<name>"   name the agent: config, CLAUDE.md, Telegram bot name
  archi setup [telegram|provider [claude|codex]|voice|matrix]
                                     onboarding (the installer runs it) or one of its steps
  archi pair [--reset] [--wait S]    pairing code for the owner's Telegram account
  archi service install [--door D]   write, enable and (re)start the door services
  archi version

Telegram (for the agent, inside a turn)
  archi tg topic create "<name>"     create a topic in the current chat (ARCHI_CHAT_ID)
  archi tg topic rename "<name>"     rename the current topic (ARCHI_THREAD_ID)
  archi tg topics [--all]            known topics / conversations
  archi tg send "<text>" [--chat C] [--thread T|main]

Matrix (for the agent, inside a turn)
  archi mx room create "<name>"      create an unencrypted room and invite the owner
  archi mx room rename "<name>"      rename the current room (ARCHI_ROOM_ID) or --room
  archi mx rooms [--deleted]         known rooms / conversations
  archi mx send "<text>" [--room R] [--notice]

Durable jobs (work that must outlive the turn; the result comes back as a new turn)
  archi job run [--label L] [--cwd DIR] -- <command …>
  archi job agent [--label L] [--provider claude|codex] "<task>"
  archi job list | show <id> | cancel <id> [--reason R] | reap

Self-learning loop
  archi learn [status] | review [--conversation KEY] [--dry-run] | curate [--dry-run] | enable | disable

Config
  archi config get KEY [--reveal]
  archi config set KEY VALUE
"""
from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from core.config import DEFAULTS, KNOWN_KEYS, Config, mask  # noqa: E402
from doors.matrix import cli as mx_cli  # noqa: E402
from doors.telegram import cli as tg_cli  # noqa: E402
from ops import cli as ops_cli  # noqa: E402


def cmd_config(args) -> int:
    cfg = Config()
    if args.config_cmd == "get":
        value = cfg.get(args.key)
        print(value if args.reveal else mask(args.key, value))
        return 0
    if args.key not in KNOWN_KEYS and args.key not in DEFAULTS and not args.force:
        known = ", ".join(KNOWN_KEYS)
        print(f"unknown key {args.key!r} (known: {known}); pass --force to set it anyway", file=sys.stderr)
        return 2
    cfg.set(args.key, args.value)
    print(f"{args.key} = {mask(args.key, args.value)}")
    return 0


def main(argv: list[str] | None = None) -> int:
    try:   # keep our lines in order with the output of the subprocesses we run (pipes, journald)
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, ValueError):
        pass
    ap = argparse.ArgumentParser(prog="archi", description="Archi command line",
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    ops_cli.add_parsers(sub)
    tg_cli.add_parser(sub)
    mx_cli.add_parser(sub)
    c = sub.add_parser("config", help="read or change config/archi.env")
    csub = c.add_subparsers(dest="config_cmd", required=True)
    g = csub.add_parser("get")
    g.add_argument("key")
    g.add_argument("--reveal", action="store_true", help="print secrets in full")
    s = csub.add_parser("set")
    s.add_argument("key")
    s.add_argument("value")
    s.add_argument("--force", action="store_true")
    args = ap.parse_args(argv)
    if args.cmd == "config":
        return cmd_config(args)
    if args.cmd == "tg":
        return tg_cli.run(args)
    if args.cmd == "mx":
        return mx_cli.run(args)
    return ops_cli.run(args)


if __name__ == "__main__":
    sys.exit(main())
